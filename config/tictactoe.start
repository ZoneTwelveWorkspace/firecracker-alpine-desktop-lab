#!/bin/sh
set -eu

web_root=/var/www/tictactoe
pid_file=/run/tictactoe-httpd.pid
log_file=/var/log/tictactoe-httpd.log

install -d -m 0755 "$web_root"

if [ -f "$pid_file" ]; then
  old_pid="$(cat "$pid_file")"
  if kill -0 "$old_pid" 2>/dev/null; then
    kill "$old_pid"
  fi
  rm -f "$pid_file"
fi

: > "$log_file"
busybox nc -lk -p 8080 -e /usr/local/bin/tictactoe-http >>"$log_file" 2>&1 &
server_pid=$!
echo "$server_pid" > "$pid_file"

sleep 1
if ! kill -0 "$server_pid" 2>/dev/null; then
  echo "Tic-Tac-Toe HTTP service failed; see $log_file" >&2
  exit 1
fi
